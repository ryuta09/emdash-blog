{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-blog",
			"database_id": "dd748414-f726-400d-8695-10b7aa7aeaf1",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media",
		},
	],
	// Astro session storage (created by the first deploy attempt)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "1e5cc93456404ba3b9b755d0585262b7",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
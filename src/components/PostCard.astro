---
import type { ContentBylineCredit, EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
	edit?: EditProxy;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines,
	edit,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("ja-JP", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	: null;
---

<article class="flex flex-col">
	<a href={href} class="group block text-inherit no-underline">
		{
			featuredImage ? (
				<div
					class="mb-4 aspect-[16/10] overflow-hidden rounded-lg bg-surface [&_img]:size-full [&_img]:object-cover [&_img]:[transition:transform_0.3s_ease] group-hover:[&_img]:[transform:scale(1.03)]"
					{...edit?.featured_image}
				>
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="mb-4 aspect-[16/10] rounded-lg bg-surface" />
			)
		}
		<div class="flex-1">
			<div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-0 text-sm text-muted">
				{
					bylines && bylines.length > 0 && (
						<>
							<div class="flex items-center gap-[2px] whitespace-nowrap">
								{bylines.slice(0, 1).map((credit) => (
									<span class="inline-flex items-center gap-1">
										{credit.byline.avatarMediaId && (
											<img
												src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
												alt={credit.byline.displayName}
												class="size-(--avatar-size-xs) rounded-full object-cover"
											/>
										)}
										<span class="font-medium text-text-secondary">
											{credit.byline.displayName}
										</span>
									</span>
								))}
								{bylines.length > 1 && (
									<span
										class="relative ml-[2px] cursor-default rounded text-xs text-muted outline-offset-2 focus-visible:outline-2 focus-visible:outline-brand after:pointer-events-none after:absolute after:bottom-[calc(100%+6px)] after:left-1/2 after:z-10 after:hidden after:-translate-x-1/2 after:rounded after:bg-text after:px-2 after:py-1 after:text-xs after:font-normal after:whitespace-nowrap after:text-bg after:content-[attr(data-tooltip)] hover:after:block focus-visible:after:block"
										data-tooltip={bylines
											.slice(1)
											.map((c) => c.byline.displayName)
											.join(", ")}
										title={bylines
											.slice(1)
											.map((c) => c.byline.displayName)
											.join(", ")}
										tabindex="0"
									>
										+{bylines.length - 1}
									</span>
								)}
							</div>
							{(formattedDate || readingTime) && <span class="size-[3px] rounded-full bg-muted" />}
						</>
					)
				}
				{formattedDate && <time class="whitespace-nowrap">{formattedDate}</time>}
			</div>
			<h2
				class="mb-2 text-xl leading-snug font-heading tracking-snug [transition:color_var(--transition-fast)] group-hover:text-brand"
				{...edit?.title}
			>{title}</h2>
			{excerpt && <p class="line-clamp-2 text-base leading-relaxed text-text-secondary" {...edit?.excerpt}>{excerpt}</p>}
		</div>
	</a>
	{
		tags && tags.length > 0 && (
			<div class="mt-3 flex flex-wrap gap-2">
				{tags.slice(0, 2).map((tag) => (
					<a href={`/tag/${tag.slug}`} class="inline-block rounded bg-surface px-2 py-(--tag-padding-y) text-xs text-text-secondary no-underline [transition:color_var(--transition-fast),background_var(--transition-fast)] hover:bg-border hover:text-text">
						{tag.label}
					</a>
				))}
			</div>
		)
	}
</article>


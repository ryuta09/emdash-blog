---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="All Posts" description="Browse all blog posts">
	<div class="mx-auto max-w-content px-6 pt-8 pb-16 max-[600px]:px-4 max-[600px]:pt-6 max-[600px]:pb-12">
		<header class="mb-12">
			<h1 class="mb-2 text-4xl font-display tracking-tight max-[600px]:text-3xl">All Posts</h1>
			<p class="text-lg text-muted">
				{posts.length}{" "}
				{posts.length === 1 ? "article" : "articles"}
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="text-lg text-muted">No posts yet.</p>
			) : (
				<div class="flex flex-col">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<article class="border-b border-border-subtle py-8 first:pt-0 last:border-b-0">
							<a href={`/posts/${post.id}`} class="group block text-inherit no-underline">
								<div class="mb-2 flex items-center gap-3 text-sm text-muted">
									{bylines.length > 0 && (
										<>
											<div class="flex items-center gap-[2px]">
												{bylines.slice(0, 2).map((credit, index) => (
													<>
														{index > 0 && <span class="mr-[2px] text-muted">,</span>}
														<span class="inline-flex items-center gap-1">
															{credit.byline.avatarMediaId && (
																<img
																	src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																	alt={credit.byline.displayName}
																	class="size-(--avatar-size-sm) rounded-full object-cover"
																/>
															)}
															<span class="font-medium text-text-secondary">
																{credit.byline.displayName}
															</span>
														</span>
													</>
												))}
												{bylines.length > 2 && (
													<span class="ml-[2px] text-xs text-muted">+{bylines.length - 2}</span>
												)}
											</div>
											<span class="size-[3px] rounded-full bg-muted" />
										</>
									)}
									{post.data.publishedAt && (
										<time>{formatDate(post.data.publishedAt)}</time>
									)}
									{post.data.publishedAt && <span class="size-[3px] rounded-full bg-muted" />}
									<span>{getReadingTime(post.data.content)} min read</span>
								</div>
								<h2
									class="mb-2 text-2xl leading-snug font-heading tracking-snug [transition:color_var(--transition-fast)] group-hover:text-brand max-[600px]:text-xl"
									{...post.edit.title}
								>{post.data.title}</h2>
								{post.data.excerpt && (
									<p class="text-lg leading-relaxed text-text-secondary" {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
							</a>
							{tags.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-2">
									{tags.slice(0, 3).map((t) => (
										<a href={`/tag/${t.slug}`} class="inline-block rounded bg-surface px-2 py-(--tag-padding-y) text-xs text-text-secondary no-underline [transition:color_var(--transition-fast),background_var(--transition-fast)] hover:bg-border hover:text-text">
											{t.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}
		<nav aria-label="Pagination">
			{cursor && <a href="/posts">First page</a>}
			{
				nextCursor && (
					<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</div>
</Base>


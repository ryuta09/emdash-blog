---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description="Search blog posts"
>
	<section class="mx-auto max-w-content px-6 pt-8 pb-16">
		<h1 class="mb-6 text-2xl">Search</h1>

		<form method="get" action="/search" class="mb-8 flex gap-2">
			<label for="site-search-query" class="sr-only"
				>Search blog posts</label
			>
			<input
				id="site-search-query"
				type="search"
				name="q"
				value={query}
				placeholder="Search posts..."
				class="flex-1 rounded border border-border bg-bg px-4 py-2 text-base text-text focus:border-brand focus:outline-none"
				autofocus
			/>
			<button
				type="submit"
				class="cursor-pointer rounded border-none bg-brand px-6 py-2 text-base font-medium text-on-brand hover:opacity-90"
			>Search</button>
		</form>

		{
			query && (
				<p class="mb-6 text-muted">
					{results.length === 0
						? `No results for "${query}"`
						: `${results.length} result${results.length === 1 ? "" : "s"} for "${query}"`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="m-0 flex list-none flex-col p-0">
					{results.map((result) => (
						<li class="border-b border-border-subtle py-6 first:pt-0 last:border-b-0">
							<a
								href={`/posts/${result.slug ?? result.id}`}
								class="group block text-inherit no-underline"
							>
								<h2 class="mb-2 text-xl leading-snug font-heading [transition:color_var(--transition-fast)] group-hover:text-brand">{result.title ?? "Untitled"}</h2>
								{result.snippet && (
									<p
										class="text-base leading-relaxed text-text-secondary [&_mark]:rounded-[2px] [&_mark]:bg-brand-ring [&_mark]:px-[0.1em] [&_mark]:text-inherit"
										set:html={result.snippet}
									/>
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="text-muted">Enter a search term to find posts.</p>}
	</section>
</Base>


---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<div class="page-center flex flex-1 flex-col justify-center px-6 py-24 text-center">
		<h1 class="mb-2 text-5xl text-border">404</h1>
		<p class="mb-6 text-muted">The page you're looking for doesn't exist.</p>
		<a href="/" class="self-center text-text">Go back home</a>
	</div>
</Base>

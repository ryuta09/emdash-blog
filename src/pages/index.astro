---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagEntryIds = posts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");
---

<Base title={siteTitle} description={siteTagline}>
	{
		posts.length === 0 ? (
			<section class="mx-auto flex max-w-[400px] flex-col items-center gap-3 px-6 py-20 text-center">
				<h1>記事がありません。</h1>
				<a href="/_emdash/admin/content/posts/new" class="mt-4 inline-block rounded bg-brand px-6 py-3 text-sm font-medium text-on-brand no-underline [transition:background_var(--transition-fast)] hover:bg-brand-hover">
					Create a post
				</a>
			</section>
		) : (
			<div class="mx-auto max-w-wide px-6 py-16 max-[900px]:px-4 max-[900px]:pt-6 max-[900px]:pb-12">
				{posts.length > 0 && (
					<section>
						<div class="grid grid-cols-3 gap-x-8 gap-y-12 max-[900px]:grid-cols-2 max-[900px]:gap-x-6 max-[900px]:gap-y-8 max-[600px]:grid-cols-1 max-[600px]:gap-8">
								{posts.map((post) => (

								<PostCard
									title={post.data.title ?? "Untitled"}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={`/posts/${post.id}`}
									date={post.data.publishedAt ?? undefined}
									readingTime={getReadingTime(post.data.content)}
									tags={tagsByEntry.get(post.data.id) ?? []}
									edit={post.edit}
								/>
								))}
						
						</div>
					</section>
				)}
			</div>
		)
	}
</Base>

